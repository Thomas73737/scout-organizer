# Scout Organizer Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Server
PORT=5000
NODE_ENV=development

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# Optional: For Replit deployment
REPL_ID=
REPL_SLUG=
REPL_OWNER=
OIDC_ISSUER=
OIDC_CLIENT_ID=

# ============================================
# Vercel Deployment
# ============================================
# Set these in the Vercel dashboard under Settings -> Environment Variables
# (or with `vercel env add`), for BOTH Production and Preview:
#
# Required:
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_SERVICE_KEY=your-supabase-service-role-key
#
# Vercel sets NODE_ENV=production for you.
#
# Recommended:
#   STORAGE_DRIVER=supabase
#     Selects the Supabase Storage backend for uploads. Auto-detected on
#     Vercel, but set it explicitly to be safe. Run
#     supabase/migrations/002_storage_buckets.sql first to create the buckets.
#   SUPABASE_STORAGE_BUCKET=uploads
#   SUPABASE_PUBLIC_STORAGE_BUCKET=public
#   ADMIN_SETUP_TOKEN=<long random string>
#     Enables POST /api/users/create-admin, which is otherwise disabled in
#     production. The token must be sent in the x-admin-setup-token header.
#
# Optional (for push notifications):
#   VAPID_PUBLIC_KEY=your_vapid_public_key
#   VAPID_PRIVATE_KEY=your_vapid_private_key
#   VAPID_SUBJECT=mailto:admin@example.com
#
# OIDC login is optional. The app's sign-in is the email/password form at
# POST /api/users/login, which needs no identity provider. Only set REPL_ID and
# ISSUER_URL if you actually want the /api/login redirect flow.

# ============================================
# Railway Deployment
# ============================================
# Set these environment variables in your Railway dashboard:
#   Variables tab
#
# Required:
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_SERVICE_KEY=your-supabase-service-role-key
#   NODE_ENV=production
#
# PORT is set automatically by Railway — do not override it.
#
# Optional (for push notifications):
#   VAPID_PUBLIC_KEY=your_vapid_public_key
#   VAPID_PRIVATE_KEY=your_vapid_private_key
#   VAPID_SUBJECT=mailto:admin@example.com
